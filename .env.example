# Shared secrets
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
SERVICE_API_KEY=internal-service-key-change-me

# Frontend
FRONTEND_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# PostgreSQL
POSTGRES_USER=fems
POSTGRES_PASSWORD=fems_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Service database URLs
AUTH_DATABASE_URL=postgresql://fems:fems_password@localhost:5432/auth_db
EXTINGUISHER_DATABASE_URL=postgresql://fems:fems_password@localhost:5432/extinguisher_db
NOTIFICATION_DATABASE_URL=postgresql://fems:fems_password@localhost:5432/notification_db
NOTIFICATION_JWT_SECRET=dev-jwt-secret-change-in-production

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
EXTINGUISHER_SERVICE_URL=http://localhost:3002
REPORTING_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# SMTP (use Ethereal Email for dev: https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-pass
SMTP_FROM="TZW LTD FEMS <noreply@tzw-ltd.com>"

# Ports
GATEWAY_PORT=3000
AUTH_PORT=3001
EXTINGUISHER_PORT=3002
REPORTING_PORT=3003
NOTIFICATION_PORT=3004
FRONTEND_PORT=3100
